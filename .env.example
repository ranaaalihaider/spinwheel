# ============================================================================
# AWS Student Builder Group — COMSATS University Islamabad
# Lucky Draw & Event Spin Wheel Configuration (.env.example)
# ============================================================================

# Connected Google Spreadsheet ID (Read-Only link sharing enabled)
# Default points to the official event registration spreadsheet:
VITE_GOOGLE_SHEET_ID=1hOghDsBghg1m8VNGH4LR-P5US2uGn6XNNhzQ6E1ga_Q

# Configurable Column Headers in the Google Spreadsheet
VITE_SHEET_NAME_COLUMN=Name
VITE_SHEET_ID_COLUMN=Reg No

# Optional: Google Apps Script Web App or Serverless API URL
# If set, the app fetches pre-hashed JSON from this endpoint instead of direct gviz query.
VITE_PARTICIPANTS_API_URL=

# Organizer PIN required to unlock administrative actions (Reset Session, Repeat Winner Policy, Sandbox)
VITE_ORGANIZER_PIN=2026
